<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
	xmlns="https://jakarta.ee/xml/ns/persistence">

	<persistence-unit name="MiProyectoPU"
		transaction-type="JTA">
		<!-- Datasource administrado por WildFly -->
		<jta-data-source>java:jboss/datasources/DB2DS</jta-data-source>

		<!-- Registrar la entidad Profesor -->
		<class>com.miempresa.entity.Profesor</class>

		<properties>
			<!-- Dialecto de Hibernate para IBM DB2 -->
			<property name="hibernate.dialect"
				value="org.hibernate.dialect.DB2Dialect" />

			<!-- Mostrar SQL en la consola -->
			<property name="hibernate.show_sql" value="true" />
			<property name="hibernate.format_sql" value="true" />

			<!-- Estrategia de tablas en desarrollo -->
			<property
				name="jakarta.persistence.schema-generation.database.action"
				value="update" />
		</properties>
	</persistence-unit>

</persistence>